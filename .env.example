# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dump-dump-brain
# Set to true if your database requires an SSL connection
DATABASE_SUPPORT_SSL=false

# Server Ports
# Port for the main API server
API_SERVER_PORT=3000
# Port for the interactive docs server
DOC_SERVER_PORT=3001

# EmailJS (used for sending OTP emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# JWT
# A long, random secret string for signing JWTs
JWT_PRIVATE_KEY=your_super_secret_jwt_key_here

# Proxy & Security
# Set to true if running behind a reverse proxy (e.g. Nginx)
BEHIND_PROXY=false
# Set to true to enable secure cookies (requires HTTPS)
WEBSITE_SECURE=false
